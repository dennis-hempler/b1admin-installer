# Secrets — matched by filename at ANY depth.
# Deliberately not path-anchored: environment directories can be nested
# (e.g. infrastructure/environments/<customer>/prod/), and an anchored
# pattern would silently fail to ignore the real secret file there.
app-config-secret.json
bootstrap-admin-secret.json
customer-values.json
**/app-config-secret.json
**/bootstrap-admin-secret.json
**/customer-values.json

